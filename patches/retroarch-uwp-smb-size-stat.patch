+#ifdef __WINRT__
+/* Copy a remote file through the frontend VFS for cores using native I/O.
+ * Keep memory bounded and reject partial reads, writes and failed closes. */
+static bool content_file_copy_vfs_to_cache(const char *src, const char *dst)
+{
+   char buffer[64 * 1024];
+   int64_t remaining, requested, received;
+   bool success = false;
+   RFILE *input = filestream_open(src, RETRO_VFS_FILE_ACCESS_READ,
+         RETRO_VFS_FILE_ACCESS_HINT_NONE);
+   RFILE *output = NULL;
+
+   if (!input)
+      goto cleanup;
+   if ((remaining = filestream_get_size(input)) < 0)
+      goto cleanup;
+   output = filestream_open(dst, RETRO_VFS_FILE_ACCESS_WRITE,
+         RETRO_VFS_FILE_ACCESS_HINT_NONE);
+   if (!output)
+      goto cleanup;
+
+   while (remaining > 0)
+   {
+      requested = remaining < (int64_t)sizeof(buffer)
+            ? remaining : (int64_t)sizeof(buffer);
+      received = filestream_read(input, buffer, requested);
+      if (received <= 0 || received > requested
+            || filestream_write(output, buffer, received) != received)
+         goto cleanup;
+      remaining -= received;
+   }
+   if (filestream_flush(output) != 0)
+      goto cleanup;
+   success = true;
+
+cleanup:
+   if (input && filestream_close(input) != 0)
+      success = false;
+   if (output && filestream_close(output) != 0)
+      success = false;
+   if (!success && output)
+      filestream_delete(dst);
+   return success;
+}
+#endif
 
